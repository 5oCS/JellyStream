<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.Jellystream</AssemblyName>
    <RootNamespace>Jellystream</RootNamespace>
<Version>0.14.7</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <JellyfinReferencePath Condition="'$(JellyfinReferencePath)' == ''">../.jellyfin</JellyfinReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(JellyfinReferencePath)/*.dll" Private="false" />
    <EmbeddedResource Include="Configuration.html" />
    <EmbeddedResource Include="Assets/anime.png" />
    <EmbeddedResource Include="Assets/popcorn.png" />
    <EmbeddedResource Include="Assets/music.png" />
    <EmbeddedResource Include="Assets/audiobook.png" />
    <EmbeddedResource Include="Assets/podcast.png" />
  </ItemGroup>
</Project>
